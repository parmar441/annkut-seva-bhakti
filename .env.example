# Copy to .env (docker compose) or backend/.env (local dev) and adjust.
ENVIRONMENT=development

MONGO_URL=mongodb://localhost:27017
# MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/   # MongoDB Atlas
# MONGO_URL=mongomock://   # dev-only in-memory demo with sample data (needs requirements-dev.txt)
MONGO_DB=annkut_seva

# REQUIRED in production: a long random secret, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Secure cookies. Browsers accept these on http://localhost; everywhere else needs HTTPS.
# Set false only if you test over plain http on a non-localhost address.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Browser origins allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Per-IP limits, sized for a whole event behind one Wi-Fi/NAT address (500+ people at once).
# Password guessing is stopped per account (LOGIN_FAILURES_*), not by these.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=1500/minute
REGISTER_RATE_LIMIT=600/minute;3000/hour
REFRESH_RATE_LIMIT=3000/minute
API_RATE_LIMIT=6000/minute
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_FAILURES_PER_USER_IP=10
LOGIN_FAILURES_PER_USER=50

# Capacity: Argon2 checks run in parallel per process (~64 MiB RAM each); Mongo connection pool size.
HASH_CONCURRENCY=8
MONGO_MAX_POOL_SIZE=200
MONGO_TIMEOUT_MS=8000
HIBP_ENABLED=false

APP_TIMEZONE=America/New_York
WEEK_START=sunday
LONG_SESSION_HOURS=16
MAX_SESSION_HOURS=24
MISSING_CLOCK_OUT_HOURS=12
